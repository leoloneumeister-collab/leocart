{
  "name": "sitehold",
  "private": true,
  "version": "0.1.0",
  "description": "SITEHOLD: a CS style 5v5 bomb defusal shooter that runs in the browser, offline against bots.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim": "node scripts/sim.ts",
    "test": "node tests/run-all.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "typescript": "5.9",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT"
}
